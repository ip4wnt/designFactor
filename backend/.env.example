# Локальная Ollama/vLLM без авторизации: LLM_API_KEY оставь пустым.
# Облачный OpenAI-совместимый API (OpenAI, DeepSeek, OpenRouter, ...):
# укажи его base_url и впиши свой ключ в LLM_API_KEY.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=gpt-4o-mini
LLM_API_KEY=

VLM_BASE_URL=http://localhost:11434/v1
VLM_MODEL_NAME=gpt-4o-mini
VLM_API_KEY=

STORAGE_DIR=storage
SKILLS_DIR=skills

# Отключить VLM-аудит контента (11 да/нет вопросов из Приложения 1 ТЗ),
# оставив только детерминированные проверки. По умолчанию включён; при
# недоступном VLM-эндпоинте аудит не падает, а помечает содержательные
# проверки как невыполненные (graceful degradation) — см. docs/AUDIT.md.
VLM_AUDIT_ENABLED=true
